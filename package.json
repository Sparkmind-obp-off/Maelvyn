{
  "name": "maelvyn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MAELVYN — Agentic Shared Venture Studio OS (development foundation)",
  "scripts": {
    "build:web": "vite build",
    "build:worker": "esbuild server/worker.ts --bundle --format=esm --platform=neutral --target=es2022 --main-fields=module,main --conditions=worker,browser --outfile=dist/_worker.js --log-level=warning",
    "build": "npm run build:web && npm run build:worker",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "eslint server web/src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply maelvyn-dev-db --local",
    "db:migrate:dev": "wrangler d1 migrations apply maelvyn-dev-db --remote",
    "deploy:dev": "npm run build && wrangler pages deploy dist --project-name maelvyn-dev --branch main",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test:e2e": "node tests/e2e/clerk-signin.e2e.mjs",
    "db:migrate:production": "wrangler d1 migrations apply maelvyn-production-db --remote --config wrangler.production.jsonc",
    "deploy:production": "npm run build && wrangler pages deploy dist --project-name maelvyn-production --branch main --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@clerk/react": "^6.18.9",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
